# Copie para .env e preencha. NUNCA versionar o .env real.

# PostgreSQL. Na VPS: Postgres ouvindo só em 127.0.0.1, usuário dedicado da
# aplicação (sem SUPERUSER), senha longa e aleatória.
DATABASE_URL="postgresql://USUARIO:SENHA@127.0.0.1:5432/planometas?schema=public"

# Chave que cifra/assina o JWT de sessão do Auth.js. Gere uma por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar este valor derruba todas as sessões ativas.
AUTH_SECRET=""

# OBRIGATÓRIO em produção: a URL pública exata (https) OU AUTH_TRUST_HOST=true.
# Com AUTH_URL o Auth.js não deriva o host de headers da requisição e emite
# cookies com prefixo __Secure-. AUTH_TRUST_HOST=true só é seguro atrás de um
# proxy que controla os headers de host (Render, Nginx) — nunca exposto direto.
# AUTH_URL="https://metas.uba.mg.gov.br"
# AUTH_TRUST_HOST=true

# De onde vem o IP real do visitante (usado no limite de tentativas de login):
#   vazio      → VPS com Nginx: X-Real-IP, senão o último item do X-Forwarded-For
#   "primeiro" → Render: primeiro item do X-Forwarded-For
# IP_CLIENTE_XFF=primeiro
